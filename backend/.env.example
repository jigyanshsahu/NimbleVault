# ─────────────────────────────────────────────────────────────────────────────
# NimbleVault – Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit the real .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=NimbleVault
DEBUG=false

# ── Database ──────────────────────────────────────────────────────────────────
# Option 1: Zero-Setup Local SQLite (Default - Recommended for instant local testing)
DATABASE_URL=sqlite+aiosqlite:///nimblevault.db
# Option 2: PostgreSQL (Production)
# DATABASE_URL=postgresql+asyncpg://postgres:yourpassword@localhost:5432/nimblevault

# ── Google Drive ──────────────────────────────────────────────────────────────
# Path to your service account JSON key file (downloaded from GCP Console)
GOOGLE_SERVICE_ACCOUNT_JSON=service_account.json

# ── YouTube OAuth2 ────────────────────────────────────────────────────────────
# Path to the OAuth2 client secrets JSON (downloaded from GCP Console)
YOUTUBE_CLIENT_SECRETS_JSON=client_secrets.json
# Path where the refreshable token will be stored after first login
YOUTUBE_TOKEN_JSON=youtube_token.json
# YouTube video privacy: private | unlisted | public
YOUTUBE_PRIVACY_STATUS=private
# YouTube video category ID (22 = People & Blogs)
YOUTUBE_VIDEO_CATEGORY_ID=22

# ── Gemini AI ─────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# ── Local Temp Storage ────────────────────────────────────────────────────────
# Directory for temporary video downloads (cleaned up after upload)
TEMP_DOWNLOAD_DIR=downloads/temp
